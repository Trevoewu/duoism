{
  "name": "duoism",
  "version": "1.0.0",
  "private": true,
  "description": "A bilingual, dual-tone Astro blog theme with automatic Atkinson image dithering, math typesetting, and wide-screen TOC. Derived from Twoism.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "note:create": "node scripts/run-ts.mjs scripts/create-note.ts",
    "portrait:create": "node scripts/run-ts.mjs scripts/create-portrait.ts",
    "image:dither": "node scripts/run-ts.mjs scripts/dither-image.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "~7.3.9",
    "@astrojs/mdx": "~8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "~7.3.8",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.15.0",
    "typescript": "^6.0.3"
  }
}
